<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AquaScope" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorPrimaryDark">@color/navy_deep</item>
        <item name="colorSecondary">@color/amber</item>
        <item name="colorAccent">@color/amber</item>
        <item name="colorOnPrimary">@color/navy_deep</item>
        <item name="colorSurface">@color/navy</item>
        <item name="colorOnSurface">@color/warm_white</item>
        <item name="android:statusBarColor">@color/navy_deep</item>
        <item name="android:navigationBarColor">@color/navy_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/navy_deep</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:textColorPrimary">@color/warm_white</item>
        <item name="android:textColorSecondary">@color/warm_muted</item>
        <item name="android:colorBackground">@color/navy_deep</item>
        <item name="materialButtonStyle">@style/Widget.AquaScope.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.AquaScope.BottomNav</item>
        <item name="chipStyle">@style/Widget.Smriti.Chip</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Smriti.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Smriti.Dialog</item>
    </style>

    <style name="ThemeOverlay.Smriti.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/navy</item>
        <item name="android:textColorPrimary">@color/warm_white</item>
        <item name="android:textColorSecondary">@color/warm_muted</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AquaScope.Button.Ghost</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AquaScope.Button.Ghost</item>
    </style>

    <style name="Text.AquaScope.Brand" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/warm_white</item>
        <item name="android:textSize">@dimen/brand_size</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="Text.AquaScope.Headline" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/warm_white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.AquaScope.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/warm_muted</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Text.AquaScope.Score" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/score_size</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/warm_white</item>
    </style>

    <style name="Text.AquaScope.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/warm_faint</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.AquaScope.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">@color/cyan</item>
        <item name="android:textColor">@color/navy_deep</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">14sp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/cyan_soft</item>
    </style>

    <style name="Widget.AquaScope.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/ocean</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/warm_white</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="Widget.AquaScope.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/cyan</item>
    </style>

    <style name="Widget.AquaScope.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">36dp</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/warm_white</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.AquaScope.SectionBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/warm_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.AquaScope.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/navy_deep</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemRippleColor">@color/cyan_soft</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.AquaScope.NavIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.AquaScope.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/cyan_soft</item>
    </style>

    <style name="Widget.Smriti.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/navy</item>
        <item name="chipStrokeColor">@color/ocean</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/warm_muted</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="rippleColor">@color/cyan_soft</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
