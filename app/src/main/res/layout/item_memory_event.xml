<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/lineTop"
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:background="@color/ocean" />

        <View
            android:id="@+id/nodeDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_nav_circle_selected" />

        <View
            android:id="@+id/lineBottom"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/ocean" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/textMemTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/warm_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textMemPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/warm_white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textMemSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/warm_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textMemScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:paddingTop="22dp"
        android:textColor="@color/cyan"
        android:textSize="15sp" />
</LinearLayout>
